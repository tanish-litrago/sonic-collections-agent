# Admin login for the web app
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string

# Organization mailbox (Gmail + App Password). The test "customer" mailbox is only used to send replies to it.
MAIL_USER=
MAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
IMAP_HOST=imap.gmail.com

# LLM: gemini (needs LLM_API_KEY) or ollama (local model)
LLM_PROVIDER=gemini
LLM_API_KEY=
OLLAMA_MODEL=gemma4:e4b

# Optional: pin "today" for overdue calculation, e.g. 2026-11-04
DEMO_TODAY=
